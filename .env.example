# =============================================================================
# CONFIGURACIÓN DE ENTORNO — KRONA VAULT™ (Proxmox VE + Docker Self-Hosted)
# =============================================================================

# Dominio FQDN (Usado para TLS DNS-01 y WebAuthn Passkeys RP_ID)
APP_DOMAIN=vault.mitienda.com
TZ=America/Mexico_City

# Base de Datos PostgreSQL 16 (Double-Entry Ledger ACID)
POSTGRES_USER=kv_admin
POSTGRES_PASSWORD=cambia_este_password_super_seguro_2026
POSTGRES_DB=krona_vault

# Valkey / Redis (Anti-Replay Nonce + WebSockets PubSub)
VALKEY_PASSWORD=cambia_este_password_valkey_2026

# Llaves Criptográficas del Servidor (Mantener fuera de la Base de Datos)
JWT_SECRET=llave_jwt_256_bits_generada_con_openssl_rand_hex_32
QR_HMAC_SECRET=llave_hmac_para_qr_totp_dinamico_y_gafetes_2026
AUDIT_HSM_SECRET=llave_externa_para_sellar_cadena_hash_auditoria_2026

# Cloudflare (Opcional en desarrollo local; Requerido en Producción para TLS DNS-01 y Tunnel)
CF_DNS_API_TOKEN=tu_token_cloudflare_dns_edit
CF_TUNNEL_TOKEN=tu_token_cloudflare_zero_trust_tunnel
